{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"paths": { "@acme/ordering/*": ["./packages/ordering/src/*"] }
	},
	"include": ["apps/**/*", "packages/**/*"]
}
